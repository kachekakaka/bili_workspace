# Runtime and network-security settings owned by the selected data root.
# Existing values win; newly introduced keys are appended without replacement.
BILI_APP_MODE=local
BILI_HOST=
BILI_PORT=
BILI_PUBLIC_BASE_URL=
BILI_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
BILI_TRUSTED_PROXY_IPS=127.0.0.1
BILI_ALLOW_IP_HOSTS=
BILI_COOKIE_SECURE=
BILI_HSTS=
BILI_EXPORT_TTL_SEC=86400
BILI_MIN_FREE_GIB=1
BILI_DOWNLOAD_CONCURRENCY=1
BILI_TRANSCODE_THREADS=0

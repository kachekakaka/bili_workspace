# QNAP host directories. This file is copied to docker/.env on first use.
CONFIG_DIR=/share/Container/bili-workspace/config
USERDATA_DIR=/share/Container/bili-workspace/userdata
MEDIA_DIR=/share/Multimedia/Bilibili

# Build the current checkout into a local image. Existing docker/.env values
# are preserved, so older deployments must switch BUILD_LOCAL to true manually.
BILI_IMAGE=bili-workspace:local
BUILD_LOCAL=true

# Non-zero container user/group with write access to all three mapped directories.
PUID=1000
PGID=100
TZ=Asia/Shanghai

# NAS-side port mapping. BIND_IP may be 0.0.0.0, a LAN IP, or 127.0.0.1.
BIND_IP=0.0.0.0
HTTP_PORT=3398

# Domain/reverse-proxy settings passed to the application.
PUBLIC_BASE_URL=
TRUSTED_HOSTS=127.0.0.1,localhost
TRUSTED_PROXY_IPS=127.0.0.1
COOKIE_SECURE=false
ENABLE_HSTS=false

BOOTSTRAP_TOKEN=
EXPORT_TTL_SEC=86400
MIN_FREE_GIB=2
DOWNLOAD_CONCURRENCY=1
TRANSCODE_THREADS=0
